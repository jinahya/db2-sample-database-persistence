<!-- https://jakarta.ee/xml/ns/persistence/ -->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence ${persistence.schemaLocation}"
             version="${persistence.version}">
  <persistence-unit name="sample-test" transaction-type="RESOURCE_LOCAL">
    <description>Persistence Unit for an In-Memory DB</description>
    <provider>${persistence-unit.provider}</provider>
    <class>com.github.jinahya.db2.sample.database.persistence.Act</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Catalog</class>
    <class>com.github.jinahya.db2.sample.database.persistence.ClSched</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Customer</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Department</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Employee</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Empmdc</class>
    <class>com.github.jinahya.db2.sample.database.persistence.EmpProjAct</class>
    <class>com.github.jinahya.db2.sample.database.persistence.EmpPhoto</class>
    <class>com.github.jinahya.db2.sample.database.persistence.EmpResume</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Inventory</class>
    <class>com.github.jinahya.db2.sample.database.persistence.InTray</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Org</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Patient</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Product</class>
    <class>com.github.jinahya.db2.sample.database.persistence.ProductSupplier</class>
    <class>com.github.jinahya.db2.sample.database.persistence.ProjAct</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Project</class>
    <class>com.github.jinahya.db2.sample.database.persistence.PurchaseOrder</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Sale</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Staff</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Staffg</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Supplier</class>
    <class>com.github.jinahya.db2.sample.database.persistence.MlblogsAnswer</class>
    <class>com.github.jinahya.db2.sample.database.persistence.MlblogsQuestion</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Adefusr</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vact</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vastrde1</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vastrde2</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vdepmg1</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vdept</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vemp</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vempdpt1</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vemplp</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vempprojact</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vforpla</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vhdept</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vphone</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vproj</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vprojact</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vprojre1</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vpstrde1</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vpstrde2</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vstafac1</class>
    <class>com.github.jinahya.db2.sample.database.persistence.Vstafac2</class>
    <!-- the converters of the XML columns, which EclipseLink finds only when listed -->
    <class>com.github.jinahya.db2.sample.database.persistence.CustomerinfoStringAttributeConverter</class>
    <class>com.github.jinahya.db2.sample.database.persistence.ProductStringAttributeConverter</class>
    <class>com.github.jinahya.db2.sample.database.persistence.PurchaseOrderStringAttributeConverter</class>
    <class>com.github.jinahya.db2.sample.database.persistence.SupplierinfoStringAttributeConverter</class>
    <class>com.github.jinahya.db2.sample.database.persistence.VectorStringAttributeConverter</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <shared-cache-mode>NONE</shared-cache-mode>
    <validation-mode>CALLBACK</validation-mode>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
      <!-- https://www.h2database.com/html/features.html#compatibility -->
      <!-- NON_KEYWORDS: CL_SCHED has a column named DAY, which H2 reserves -->
      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:h2:mem:;MODE=DB2;DEFAULT_NULL_ORDERING=HIGH;NON_KEYWORDS=DAY"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value="password"/>
      <!-- ///////////////////////////////////////////////////////////////////////////////////////////// eclipselink -->
      <!-- https://wiki.eclipse.org/EclipseLink/Examples/JPA/Logging -->
      <property name="eclipselink.logging.level.sql" value="FINE"/>
      <property name="eclipselink.logging.parameters" value="true"/>
      <!-- https://wiki.eclipse.org/EclipseLink/Examples/JPA/DDL -->
      <property name="eclipselink.target-database"
                value="org.eclipse.persistence.platform.database.H2Platform"/>
      <property name="eclipselink.ddl-generation" value="create-tables"/>
      <!-- /////////////////////////////////////////////////////////////////////////////////////////////// hibernate -->
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
      <property name="hibernate.highlight_sql" value="true"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.use_sql_comment" value="true"/>
    </properties>
  </persistence-unit>
